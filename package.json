{
  "name": "animal-english-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && vite-node tools/pwa/build_sw.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "assets": "python tools/prepare_assets.py",
    "voices": "vite-node tools/tts/export_lines.ts && node tools/tts/run_python.mjs tools/tts/generate_voices.py",
    "voices:plan": "vite-node tools/tts/export_lines.ts && node tools/tts/run_python.mjs tools/tts/generate_voices.py --plan"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-node": "3.2.4",
    "vitest": "4.1.12"
  }
}
